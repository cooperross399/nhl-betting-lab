.venv/
__pycache__/
*.pyc
.env
.DS_Store
.pytest_cache/
data/raw/**
!data/raw/.gitkeep
data/processed/*.csv
# Generated reports are rebuilt by every run and are not history. The three
# measurement documents are the exception: they are the durable record the
# operating contract points at, so they are tracked deliberately.
data/outputs/*
!data/outputs/.gitkeep
!data/outputs/player_props_backtest.md
# The card's own window, beside the contract filename. Two windows
# measured separately is the point; keeping only one of them tracked
# is how a store that holds both gets described by half of itself.
!data/outputs/player_props_backtest_card.md
!data/outputs/props_calibration.md
!data/outputs/what_we_can_claim.md
!data/outputs/team_markets_measurement.md
!data/outputs/replication.md
!data/outputs/allowlist_evidence_bundle.md
!data/outputs/correction_experiment.md
!data/outputs/correction_experiment.json
!data/outputs/rest_experiment.md
!data/outputs/rest_experiment.json
!data/outputs/props_rest_experiment.md
!data/outputs/props_rest_experiment.json
data/outputs/archive/
# Priced snapshots and the forward ledger are run state, carried between
# workflow runs by the gameday-state artifact rather than by git — they grow
# every game day and are evidence, not code.
data/archive/
data/staging/*_staging.csv
data/staging/staging_provenance.json
*.egg-info/
build/
dist/
.coverage
htmlcov/
